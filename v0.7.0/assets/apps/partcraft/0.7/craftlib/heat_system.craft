% heat_system — the conduction matrix, loads and fixed temperatures of a cube mesh (used by heat_steady and
%               heat_transient; call it yourself to build your own heat solver)
%
% Usage:      s = heat_system(m, k, bc)
%   m         a voxel mesh, or a hex8 mesh of cubes (box_mesh(…, 'hex') with l/h whole numbers)
%   k         thermal conductivity (W/(mm·K) with mm: aluminium 0.2, steel 0.05)
%   bc        struct, every field optional:
%               bc.T     = { struct('nodes', n, 'value', T0), … }       fixed temperatures
%               bc.power = { struct('nodes', n, 'power', P), … }        heat input P (W), shared equally
%               bc.q     = q                                          heat generated per volume (W/mm³), a number
%                                                                     or one value per element
%               bc.flux  = { struct('nodes', n, 'flux', qn), … }        heat flux into the surface (W/mm²)
%               bc.conv  = { struct('nodes', n, 'h', hc, 'Tinf', Ta), … }  convection to Ta (hc in W/(mm²·K))
%             flux and convection act on the boundary triangles whose three nodes are all in n.
% Returns:    s.K (nodes × nodes, conduction + convection), s.f (W per node), s.fixed (node numbers), s.Tfixed
%             (their temperatures), s.free, s.h (cube side), s.nodeVolume (the lumped volume per node: the heat capacity
%             is ρc × s.nodeVolume), s.mesh, s.surfaceArea (of the convection/flux triangles).
% Method:     K = Σ_e Kt_e (hexKt: the 8-node trilinear conduction matrix of a cube, 2×2×2 Gauss, thermal.js);
%             generation q·h³/8 to each corner; flux and convection lumped: each boundary triangle gives a third of
%             its area to each corner, K_ii += hc·A_i, f_i += hc·A_i·Ta + qn·A_i (row-sum lumping, Lewis et al.).
% Units:      mm, W, K, s (k in W/(mm·K) = W/(m·K) / 1000; hc in W/(mm²·K) = W/(m²·K) / 10⁶).
% Assumes:    linear, isotropic, constant properties; radiation not included.
% References: R. W. Lewis, P. Nithiarasu, K. N. Seetharamu, Fundamentals of the Finite Element Method for Heat and
%             Fluid Flow (2004) §3.4–3.6 (conduction, convection boundary terms), §6.2 (lumped capacity).
% Check:      through heat_steady and heat_transient (bin/test-craftscript.mjs --lib).
function s = heat_system(m, k, bc)
info = meshInfo(m);
X = meshNodes(m);
E8 = meshElems(m);
nn = info.nodes; ne = info.elements;
switch info.kind
  case 'voxel'
    h = info.h;
  case 'hex8'
    d = abs(X(E8(1, [2 4 5]), :) - X(E8(1, [1 1 1]), :));
    h = d(1, 1);
    if abs(d(2, 2) - h) > 1e-9 * h || abs(d(3, 3) - h) > 1e-9 * h
      error('heat_system: the hexahedra are not cubes (%g × %g × %g); choose h so that l/h are whole numbers', d(1, 1), d(2, 2), d(3, 3));
    end
  otherwise
    error('heat_system: a voxel or hex8 mesh of cubes is needed (got %s)', info.kind);
end
K = assemble(edofs(m, 1), hexKt(k, h), [], nn);
f = zeros(nn, 1);

q = getopt(bc, 'q', 0);
if any(q(:) ~= 0)
  qe = q(:) .* ones(ne, 1) * h ^ 3 / 8;
  f = f + accumarray(E8(:), repmat(qe, 8, 1), [nn 1]);
end
P = getopt(bc, 'power', {});
for j = 1:numel(P)
  nd = P{j}.nodes(:);
  f = f + accumarray(nd, P{j}.power / numel(nd), [nn 1]);
end

% boundary triangles (node numbers are the mesh's own)
S = meshElems(meshSurface(m));
area = [];
cv = getopt(bc, 'conv', {});
fl = getopt(bc, 'flux', {});
sarea = 0;
if numel(cv) + numel(fl) > 0
  a = X(S(:, 2), :) - X(S(:, 1), :); b = X(S(:, 3), :) - X(S(:, 1), :);
  c = [a(:, 2) .* b(:, 3) - a(:, 3) .* b(:, 2), a(:, 3) .* b(:, 1) - a(:, 1) .* b(:, 3), a(:, 1) .* b(:, 2) - a(:, 2) .* b(:, 1)];
  area = sqrt(sum(c .^ 2, 2)) / 2;
end
hd = zeros(nn, 1);
for j = 1:numel(cv)
  An = nodeAreas(S, area, cv{j}.nodes, nn);
  hd = hd + cv{j}.h * An;
  f = f + cv{j}.h * cv{j}.Tinf * An;
  sarea = sarea + sum(An);
end
for j = 1:numel(fl)
  An = nodeAreas(S, area, fl{j}.nodes, nn);
  f = f + fl{j}.flux * An;
  sarea = sarea + sum(An);
end
if any(hd)
  K = K + sparse(1:nn, 1:nn, hd, nn, nn);
end

fixed = []; Tf = [];
Tb = getopt(bc, 'T', {});
for j = 1:numel(Tb)
  nd = Tb{j}.nodes(:);
  fixed = [fixed; nd];
  Tf = [Tf; Tb{j}.value * ones(numel(nd), 1)];
end
[fixed, iu] = unique(fixed);
Tf = Tf(iu);
used = false(nn, 1); used(E8(:)) = true;
free = setdiff(find(used), fixed);

s = struct('K', K, 'f', f, 'fixed', fixed, 'Tfixed', Tf, 'free', free, 'h', h, 'mesh', m, 'surfaceArea', sarea);
s.nodeVolume = accumarray(E8(:), h ^ 3 / 8, [nn 1]);   % lumped: an eighth of each cube to each corner
end

function An = nodeAreas(S, area, nodes, nn)
% a third of each boundary triangle's area to its corners, for the triangles with all three nodes in `nodes`
in = false(nn, 1); in(nodes(:)) = true;
t = all(in(S), 2);
St = S(t, :);
An = accumarray(St(:), repmat(area(t) / 3, 3, 1), [nn 1]);
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
