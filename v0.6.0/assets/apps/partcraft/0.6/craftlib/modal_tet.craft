% modal_tet — natural frequencies and mode shapes of a body meshed with quadratic tetrahedra
%
% Usage:      r = modal_tet(t, E, nu, rho, bc)
%             r = modal_tet(t, E, nu, rho, bc, k)          the k lowest modes (default 4)
%             r = modal_tet(t, E, nu, rho, bc, k, opts)
%   t         a tet10 mesh;  E, nu: elastic constants;  rho: density (tonnes/mm³ with mm, N, MPa: steel 7.85e-9)
%   bc        struct: bc.fixed (node numbers) and/or bc.fixedFaces (face numbers), held in x, y, z;
%             bc.supports = { struct('nodes', n, 'dirs', d) } as static_tet. Nothing held: give opts.sigma
%             (a negative shift, e.g. -1) and the six rigid-body modes come first, at 0 Hz.
%   opts      struct, optional: sigma (shift), tol (1e-10), show (true: mode 1 drawn deformed)
% Returns:    r.freqs (k × 1, Hz), r.omega2 (eigenvalues ω², 1/s²), r.modes (3·nodes × k, mass-normalised:
%             φᵀMφ = 1), r.mass (total mass, tonnes), r.fields (one displacement field per mode), r.dofs.
% Method:     K = Σ Ke (t10KeAll), M = Σ Me (t10MeAll: the consistent T10 mass, 4-point rule … tetfea.js);
%             held dofs removed; the k smallest eigenpairs of K φ = ω² M φ by eigs (dense below 400 unknowns,
%             else subspace iteration on (K − σM)⁻¹M with the envelope Cholesky); f = ω / 2π.
% Units:      mm, N, MPa, tonnes/mm³ → ω² in 1/s², f in Hz (N/mm per tonne = 1/s²).
% Assumes:    linear elasticity, no damping, small vibrations about the unloaded shape.
% Limits:     the consistent mass of T10 elements; no pre-stress; frequencies converge from above as the mesh is
%             refined.
% References: K.-J. Bathe, Finite Element Procedures (1996) §10.3 (consistent mass), §11.6 (subspace iteration);
%             cantilever: f1 = (1.8751²/2π) √(E I / (ρ A L⁴)) (Euler–Bernoulli; Blevins, Formulas for Natural
%             Frequency and Mode Shape (1979), table 8-1).
% Check:      steel cantilever 100 × 10 × 10 mm (E 200 GPa, ν 0.3, ρ 7850 kg/m³), x = 0 held, tet10 size 5:
%             f1 vs Euler–Bernoulli 815.3 Hz (≤ 3 %; shear and rotary inertia lower the 3-D value slightly) and vs
%             PartCraft's Simulation modal solver (tetfea.js LOBPCG) on the same mesh ≤ 1 % (test-craftscript --lib).
function r = modal_tet(t, E, nu, rho, bc, k, opts)
if nargin < 6
  k = 4;
end
if nargin < 7
  opts = struct();
end
t0 = tic;
info = meshInfo(t);
if ~strcmp(info.kind, 'tet10')
  error('modal_tet: a tet10 mesh is needed (got %s)', info.kind);
end
nn = info.nodes; n = 3 * nn;
D = edofs(t);
K = assemble(D, t10KeAll(t, E, nu), [], n);
M = assemble(D, t10MeAll(t, rho), [], n);

fixedNodes = getopt(bc, 'fixed', []);
faces = getopt(bc, 'fixedFaces', []);
for j = 1:numel(faces)
  fixedNodes = [fixedNodes(:); face_nodes(t, faces(j))];
end
fixedNodes = unique(fixedNodes(:));
held = [3 * fixedNodes - 2; 3 * fixedNodes - 1; 3 * fixedNodes];
sup = getopt(bc, 'supports', {});
for j = 1:numel(sup)
  for a = sup{j}.dirs(:)'
    held = [held; 3 * sup{j}.nodes(:) - 3 + a];
  end
end
free = setdiff((1:n)', unique(held));

eo = struct('tol', getopt(opts, 'tol', 1e-10));
if isfield(opts, 'sigma')
  eo.sigma = opts.sigma;
end
[V, L] = eigs(K(free, free), M(free, free), k, eo);
lam = diag(L);
r = struct();
r.omega2 = lam;
r.freqs = sqrt(max(lam, 0)) / (2 * pi);
r.modes = zeros(n, k);
r.modes(free, :) = V;
r.mass = sum(sum(M)) / 3;
r.dofs = numel(free);
r.fields = cell(1, k);
for j = 1:k
  r.fields{j} = field(t, reshape(r.modes(:, j), 3, nn)', 'node', sprintf('mode %d, %.4g Hz', j, r.freqs(j)));
end
r.seconds = toc(t0);
fprintf('modal_tet: %d T10 elements, %d unknowns, mass %.4g; frequencies (Hz):', info.elements, r.dofs, r.mass);
fprintf(' %.5g', r.freqs);
fprintf('\n');
if getopt(opts, 'show', true)
  show(r.fields{1}, 'name', 'modal_tet: mode 1', 'deformed', true);
end
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
