% top99 — 2-D minimum-compliance topology optimization, Sigmund's 99-line code (the original of top88)
%
% Usage:      top99(nelx, nely, volfrac, penal, rmin)
%             [x, c, loop, hist] = top99(60, 20, 0.5, 3.0, 1.5)       the MBB beam of the paper
% Computes:   the half MBB beam (as top88): element densities x (≥ 0.001) minimising compliance at the volume
%             fraction; prints each iteration, draws the densities, plots the compliance history, and shows the
%             final design as an element field on a quad mesh.
% Returns:    x (nely × nelx, row 1 at the top), c, loop, hist (compliance per iteration).
% Method:     the published top99.m: SIMP E = x^p (x ≥ 0.001), 4-node plane-stress elements (lk), element loops for
%             the compliance and its sensitivities, the mesh-independency (sensitivity) filter `check`, optimality
%             criteria `OC` (move 0.2, bisection to l2 − l1 ≤ 1e-4), stop when the largest change ≤ 0.01.
%             Changes from the paper (marked "library:"): the function is named top99 and returns its results;
%             FE() collects the element matrices as triplets and calls sparse(iK, jK, sK) once instead of
%             K(edof, edof) = K(edof, edof) + … per element (same K; per-element sparse
%             index-assignment works too, but rebuilds K each time and is much slower); the compliance history plot and final field.
% Units:      dimensionless (unit element side, unit load, E = 1, ν = 0.3).
% Assumes:    linear elasticity, plane stress, one load case.
% References: O. Sigmund, "A 99 line topology optimization code written in Matlab", Struct. Multidisc. Optim.
%             21 (2001) 120–127 — eqs. (1)–(4), the MBB example of fig. 2; M. P. Bendsøe, O. Sigmund, Topology
%             Optimization (2003) §1.2.
% Check:      top99(60, 20, 0.5, 3, 1.5) converges (change ≤ 0.01), keeps the volume at 0.500, and lands within
%             2 % of top88's sensitivity-filter result (203.19; the two codes differ only in the lower density
%             bound, 0.001 against Emin = 1e-9) (bin/test-craftscript.mjs --lib).
function [x, c, loop, hist] = top99(nelx,nely,volfrac,penal,rmin)
% INITIALIZE
x(1:nely,1:nelx) = volfrac;
loop = 0;
change = 1.;
hist = zeros(1, 0);   % library
% START ITERATION
while change > 0.01
  loop = loop + 1;
  xold = x;
% FE-ANALYSIS
  [U]=FE(nelx,nely,x,penal);
% OBJECTIVE FUNCTION AND SENSITIVITY ANALYSIS
  [KE] = lk;
  c = 0.;
  for ely = 1:nely
    for elx = 1:nelx
      n1 = (nely+1)*(elx-1)+ely;
      n2 = (nely+1)* elx   +ely;
      Ue = U([2*n1-1;2*n1; 2*n2-1;2*n2; 2*n2+1;2*n2+2; 2*n1+1;2*n1+2],1);
      c = c + x(ely,elx)^penal*Ue'*KE*Ue;
      dc(ely,elx) = -penal*x(ely,elx)^(penal-1)*Ue'*KE*Ue;
    end
  end
% FILTERING OF SENSITIVITIES
  [dc]   = check(nelx,nely,rmin,x,dc);
% DESIGN UPDATE BY THE OPTIMALITY CRITERIA METHOD
  [x]    = OC(nelx,nely,x,volfrac,dc);
% PRINT RESULTS
  change = max(max(abs(x-xold)));
  disp([' It.: ' sprintf('%4i',loop) ' Obj.: ' sprintf('%10.4f',c) ...
       ' Vol.: ' sprintf('%6.3f',sum(sum(x))/(nelx*nely)) ...
        ' ch.: ' sprintf('%6.3f',change )])
% PLOT DENSITIES
  colormap(gray); imagesc(-x); axis equal; axis tight; axis off;pause(1e-6);
  hist(loop) = c;   % library: the compliance history
  plot(hist, 'title', 'top99: compliance', 'xlabel', 'iteration', 'ylabel', 'c', 'id', 'top99');
end
% library: the final design as an element field on a quad mesh
m = quadGrid(nelx, nely, nelx, nely);
d = flipud(x)';
show(field(m, d(:), 'elem', 'density'), 'name', 'top99: density', 'range', [0 1]);
end
%%%%%%%%%% OPTIMALITY CRITERIA UPDATE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function [xnew]=OC(nelx,nely,x,volfrac,dc)
l1 = 0; l2 = 100000; move = 0.2;
while (l2-l1 > 1e-4)
  lmid = 0.5*(l2+l1);
  xnew = max(0.001,max(x-move,min(1.,min(x+move,x.*sqrt(-dc./lmid)))));
  if sum(sum(xnew)) - volfrac*nelx*nely > 0;
    l1 = lmid;
  else
    l2 = lmid;
  end
end
end
%%%%%%%%%% MESH-INDEPENDENCY FILTER %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function [dcn]=check(nelx,nely,rmin,x,dc)
dcn=zeros(nely,nelx);
for i = 1:nelx
  for j = 1:nely
    sum=0.0;
    for k = max(i-floor(rmin),1):min(i+floor(rmin),nelx)
      for l = max(j-floor(rmin),1):min(j+floor(rmin),nely)
        fac = rmin-sqrt((i-k)^2+(j-l)^2);
        sum = sum+max(0,fac);
        dcn(j,i) = dcn(j,i) + max(0,fac)*x(l,k)*dc(l,k);
      end
    end
    dcn(j,i) = dcn(j,i)/(x(j,i)*sum);
  end
end
end
%%%%%%%%%% FE-ANALYSIS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function [U]=FE(nelx,nely,x,penal)
[KE] = lk;
% library: triplets, then one sparse() (the paper adds into K(edof,edof) element by element)
iK = zeros(64*nelx*nely,1); jK = iK; sK = iK; q = 0;
F = sparse(2*(nely+1)*(nelx+1),1); U = zeros(2*(nely+1)*(nelx+1),1);
for elx = 1:nelx
  for ely = 1:nely
    n1 = (nely+1)*(elx-1)+ely;
    n2 = (nely+1)* elx   +ely;
    edof = [2*n1-1; 2*n1; 2*n2-1; 2*n2; 2*n2+1; 2*n2+2; 2*n1+1; 2*n1+2];
    iK(q+1:q+64) = repmat(edof,8,1);
    jK(q+1:q+64) = kron(edof,ones(8,1));
    sK(q+1:q+64) = x(ely,elx)^penal*KE(:);
    q = q + 64;
  end
end
K = sparse(iK, jK, sK, 2*(nelx+1)*(nely+1), 2*(nelx+1)*(nely+1));
% DEFINE LOADSAND SUPPORTS (HALF MBB-BEAM)
F = full(F); F(2,1) = -1;   % library: F dense (a sparse column is assigned the same way once the runtime allows it)
fixeddofs   = union([1:2:2*(nely+1)],[2*(nelx+1)*(nely+1)]);
alldofs     = [1:2*(nely+1)*(nelx+1)];
freedofs    = setdiff(alldofs,fixeddofs);
% SOLVING
U(freedofs,:) = K(freedofs,freedofs) \ F(freedofs,:);
U(fixeddofs,:)= 0;
end
%%%%%%%%%% ELEMENT STIFFNESS MATRIX %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function [KE]=lk
E = 1.;
nu = 0.3;
k=[ 1/2-nu/6   1/8+nu/8 -1/4-nu/12 -1/8+3*nu/8 ...
   -1/4+nu/12 -1/8-nu/8  nu/6       1/8-3*nu/8];
KE = E/(1-nu^2)*[ k(1) k(2) k(3) k(4) k(5) k(6) k(7) k(8)
                  k(2) k(1) k(8) k(7) k(6) k(5) k(4) k(3)
                  k(3) k(8) k(1) k(6) k(7) k(4) k(5) k(2)
                  k(4) k(7) k(6) k(1) k(8) k(3) k(2) k(5)
                  k(5) k(6) k(7) k(8) k(1) k(2) k(3) k(4)
                  k(6) k(5) k(4) k(3) k(2) k(1) k(8) k(7)
                  k(7) k(4) k(5) k(2) k(3) k(8) k(1) k(6)
                  k(8) k(3) k(2) k(5) k(4) k(7) k(6) k(1)];
end
