% cylinder_mesh — a mesh of the solid cylinder of radius r and length len along z (base centred on the origin)
%
% Usage:      m = cylinder_mesh(r, len, h)            quadratic tetrahedra (the default kind 'tet10')
%             m = cylinder_mesh(r, len, h, kind)      kind: 'tet10' | 'tet4' | 'voxel' | 'surface'
% Computes:   the closed surface (meshCylinder) with n sides, n = max(32, 4·ceil(2πr/h)) so the facets are about
%             h/4 long around, then a body-fitted tet mesh of size h (tetmesh) or cubes of side h (voxelize).
% Method:     a thin script over meshCylinder, tetmesh and voxelize. The surface is a polygonal prism, so the
%             meshed volume is n/(2π)·sin(2π/n)·πr²·len (n = 128: 0.04 % under πr²·len); cubes follow the
%             surface in steps of h (the voxel volume is within a few per cent for r/h ≥ 10).
% Units:      any consistent length unit (PartCraft: mm).
% Faces:      1 the base (z = 0), 2 the top (z = len), 3 the side — as face_nodes takes them.
% Limits:     the tet mesher sees only the facets (no exact cylinder), so mid-side nodes of a 'tet10' mesh lie on
%             the polygon, not on the true circle.
% References: Labelle & Shewchuk, "Isosurface stuffing", ACM TOG 26(3) 2007.
% Check:      r = 10, len = 20, h = 4: 'tet10' volume vs πr²len within 0.5 % (measured −0.14 %); 'voxel' at
%             h = 0.5 within 1 % (+0.59 %) (bin/test-craftscript.mjs --lib).
function m = cylinder_mesh(r, len, h, kind)
if nargin < 4
  kind = 'tet10';
end
if ~(r > 0 && len > 0 && h > 0)
  error('cylinder_mesh: r, len and h must be positive');
end
n = max(32, 4 * ceil(2 * pi * r / h));
s = meshCylinder(r, len, n);
switch kind
  case 'tet10'
    m = tetmesh(s, h, struct('order', 2, 'curv', 0.25, 'thick', 1, 'levels', 3));
  case 'tet4'
    m = tetmesh(s, h, struct('order', 1, 'curv', 0.25, 'thick', 1, 'levels', 3));
  case 'voxel'
    m = voxelize(s, h);
  case 'surface'
    m = s;
  otherwise
    error('cylinder_mesh: kind must be tet10, tet4, voxel or surface (got %s)', kind);
end
end
