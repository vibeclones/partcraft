% static_tet — linear static stress analysis on a quadratic tetrahedral mesh (10-node tetrahedra)
%
% Usage:      r = static_tet(t, E, nu, bc)
%             r = static_tet(t, E, nu, bc, opts)
%   t         a tet10 mesh (tet_mesh, box_mesh(…, 'tet10'), cylinder_mesh, tetmesh(…, struct('order', 2)))
%   E, nu     Young's modulus and Poisson's ratio
%   bc        struct: bc.fixed = node numbers held in x, y, z, or bc.fixedFaces = face numbers held (face_nodes);
%             optional bc.supports = { struct('nodes', n, 'dirs', [1 3]), … };
%             bc.loads = { …one struct each… }:
%               struct('nodes', n, 'force', [Fx Fy Fz])   total force shared equally by the nodes
%               struct('face', k, 'force', [Fx Fy Fz])    total force spread as a uniform traction over face k
%               struct('face', k, 'pressure', p)          pressure p on face k, pushing into the body (p > 0)
%   opts      struct, optional: tol (pcg, 1e-8) and solver 'direct' (K\f: envelope Cholesky, the default) or
%             'pcg' (algebraic multigrid PCG, for big meshes); show true
% Returns:    r.u, r.U (nodes × 3), r.stress (elements × 6, element mean of the 4 Gauss points), r.vm (per
%             element), r.compliance (fᵀu), r.reaction [x y z], r.maxDisp, r.maxVm, r.dofs, r.fields
%             {displacement (node), von Mises (element)} shown deformed on the canvas.
% Method:     K = Σ_e Ke (t10KeAll: 30×30 T10 stiffness, 4-point Gauss rule, tetfea.js) by assemble(); held dofs
%             removed; u_f = K_ff \ f_f. Face loads: a uniform traction t on a flat 6-node triangle of area A gives
%             nothing to its corners and A·t/3 to each mid-side node (consistent loads, Zienkiewicz & Taylor vol. 1
%             §8.8); 3-node triangles (tet4) give A·t/3 to each corner. Pressure acts along the triangle's inward
%             normal (the mesher's boundary triangles face outward). Stresses: t10Stress (Gauss points, averaged).
% Units:      consistent: mm, N, MPa → mm, MPa.
% Assumes:    small strains, linear isotropic elasticity.
% Limits:     face loads treat each boundary triangle as flat (exact on planes; on curved faces the mid-side
%             nodes are off the chord — use a finer mesh there); 'tet4' meshes are refused (stiff, poor stresses).
% References: O. C. Zienkiewicz, R. L. Taylor, The Finite Element Method, vol. 1 (6th ed.), §8.8 (T10), §6
%             (consistent loads); K.-J. Bathe, Finite Element Procedures (1996) §5.3.3; Euler–Bernoulli
%             δ = P L³ / (3 E I).
% Check:      cantilever 100 × 10 × 10 mm, tet10 at size 5, E = 200 GPa, ν = 0.3, face 5 (x = 0) held, 100 N down
%             on face 6: tip deflection vs P L³/3EI = 0.2000 mm (≤ 3 %), and vs PartCraft's Simulation tet solver
%             (tetfea.js solveTetStudy, the same mesh and loads) ≤ 1 % (bin/test-craftscript.mjs --lib).
function r = static_tet(t, E, nu, bc, opts)
if nargin < 5
  opts = struct();
end
t0 = tic;
info = meshInfo(t);
if ~strcmp(info.kind, 'tet10')
  error('static_tet: a tet10 mesh is needed (got %s): tet_mesh(model, size) or box_mesh(…, ''tet10'')', info.kind);
end
nn = info.nodes; n = 3 * nn;
X = meshNodes(t);

% stiffness
K = assemble(edofs(t), t10KeAll(t, E, nu), [], n);

% loads
f = zeros(n, 1);
loads = getopt(bc, 'loads', {});
for k = 1:numel(loads)
  L = loads{k};
  if isfield(L, 'nodes')
    nd = L.nodes(:); F = L.force(:)';
    for a = 1:3
      f = f + accumarray(3 * nd - 3 + a, F(a) / numel(nd), [n 1]);
    end
  else
    [~, tri] = face_nodes(t, L.face);
    A = X(tri(:, 1), :); B = X(tri(:, 2), :); C = X(tri(:, 3), :);
    nrm = crossrows(B - A, C - A) / 2;           % outward normal × triangle area
    area = sqrt(sum(nrm .^ 2, 2));
    if isfield(L, 'pressure')
      T = -L.pressure * nrm;                     % force on each triangle (rows)
    else
      T = area / sum(area) * L.force(:)';
    end
    mids = tri(:, 4:6);
    for a = 1:3
      for c = 1:3
        f = f + accumarray(3 * mids(:, c) - 3 + a, T(:, a) / 3, [n 1]);
      end
    end
  end
end

% supports
held = [];
fixedNodes = getopt(bc, 'fixed', []);
faces = getopt(bc, 'fixedFaces', []);
for k = 1:numel(faces)
  fixedNodes = [fixedNodes(:); face_nodes(t, faces(k))];
end
fixedNodes = unique(fixedNodes(:));
held = [3 * fixedNodes - 2; 3 * fixedNodes - 1; 3 * fixedNodes];
sup = getopt(bc, 'supports', {});
for k = 1:numel(sup)
  for a = sup{k}.dirs(:)'
    held = [held; 3 * sup{k}.nodes(:) - 3 + a];
  end
end
held = unique(held);
if isempty(held)
  error('static_tet: nothing holds the part (give bc.fixed, bc.fixedFaces or bc.supports)');
end
free = setdiff((1:n)', held);

% solve
u = zeros(n, 1);
solver = getopt(opts, 'solver', 'direct');
Kf = K(free, free);
switch solver
  case 'direct'
    u(free) = Kf \ f(free);
  case 'pcg'
    [x, sinfo] = pcg(Kf, f(free), struct('tol', getopt(opts, 'tol', 1e-8), 'prec', 'amg', 'dofsPerNode', 3));
    u(free) = x;
    fprintf('static_tet: PCG (%s), %d iterations, residual %.1e\n', sinfo.prec, sinfo.iterations, sinfo.residual);
  otherwise
    error('static_tet: solver must be direct or pcg');
end

% results
s = t10Stress(t, u, E, nu);
vm = vonMises(s);
R = K * u - f;
reaction = zeros(1, 3);
for a = 1:3
  ha = held(mod(held - 1, 3) == a - 1);
  reaction(a) = sum(R(ha));
end
U = reshape(u, 3, nn)';
r = struct();
r.u = u; r.U = U; r.stress = s; r.vm = vm;
r.compliance = f' * u;
r.reaction = reaction;
r.maxDisp = max(sqrt(sum(U .^ 2, 2))); r.maxVm = max(vm);
r.dofs = numel(free); r.solver = solver;
r.fields = {field(t, U, 'node', 'displacement', 'mm'), field(t, vm, 'elem', 'von Mises stress', 'MPa')};
r.seconds = toc(t0);
fprintf('static_tet: %d T10 elements, %d unknowns, max displacement %.4g, max von Mises %.4g, reaction [%.4g %.4g %.4g]\n', ...
  info.elements, r.dofs, r.maxDisp, r.maxVm, reaction(1), reaction(2), reaction(3));
if getopt(opts, 'show', true)
  show(r.fields{2}, 'name', 'static_tet: von Mises', 'deform', r.fields{1});
end
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end

function c = crossrows(a, b)
c = [a(:, 2) .* b(:, 3) - a(:, 3) .* b(:, 2), a(:, 3) .* b(:, 1) - a(:, 1) .* b(:, 3), a(:, 1) .* b(:, 2) - a(:, 2) .* b(:, 1)];
end
