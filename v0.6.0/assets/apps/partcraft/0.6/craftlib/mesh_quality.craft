% mesh_quality — element sizes, the total volume (or area) and shape quality of any mesh
%
% Usage:      q = mesh_quality(m)          (no output: prints a summary)
% Computes:   q.kind, q.nodes, q.elements, q.vol (per element: volume; area for 'quad'; 0 for 'tri'), q.volume
%             (total; for a closed 'tri' surface the volume it encloses), q.area (surface area of a 'tri' mesh, the
%             2-D area of a 'quad' mesh), q.minVol, q.maxVol, q.inverted (elements with volume ≤ 0), and for
%             tetrahedra q.minDihedral, q.maxDihedral, q.maxAspect (meshQuality); NaN where it does not apply.
% Method:     written out per element type, vectorised over the elements:
%             tet4     V = (b−a)·((c−a)×(d−a)) / 6
%             tet10    V = Σ_p w_p det J(ξ_p), 4-point Gauss rule (the rule PartCraft's tetfea.js uses), J = Σ_a x_a ∇N_a
%                      with N_corner = L(2L−1), N_mid = 4 L_i L_j (Zienkiewicz & Taylor vol. 1 §8.8, eq. 8.38)
%             hex8     the 6 tetrahedra around the 1–7 diagonal (exact for flat faces)
%             voxel    h³ each
%             quad     ½ |d1 × d2| (planar quadrilateral, diagonals d1, d2)
%             tri      area ½|(b−a)×(c−a)|; enclosed volume Σ a·(b×c) / 6 (divergence theorem; closed and outward)
% Units:      the mesh's length unit (cubed or squared).
% Limits:     the tet10 rule is exact for straight-sided elements; on curved ones it is PartCraft's own estimate.
% References: O. C. Zienkiewicz, R. L. Taylor, The Finite Element Method, vol. 1 (6th ed.), §8.8 (T10), §9.3
%             (Gauss rules for tetrahedra); dihedral angles: Shewchuk, "What is a good linear element?" (2002).
% Check:      hexGrid / voxel / tet4 / tet10 of the box 100 × 10 × 10 → volume 10000; the box surface encloses
%             10000; cylinder r 10 len 20 (tet10) within 0.5 % of πr²len (bin/test-craftscript.mjs --lib).
function q = mesh_quality(m)
info = meshInfo(m);
X = meshNodes(m);
E = meshElems(m);
ne = info.elements;
q = struct('kind', info.kind, 'nodes', info.nodes, 'elements', ne);
q.area = NaN;
q.minDihedral = NaN; q.maxDihedral = NaN; q.maxAspect = NaN;
switch info.kind
  case 'tri'
    a = X(E(:, 1), :); b = X(E(:, 2), :); c = X(E(:, 3), :);
    n = crossrows(b - a, c - a);
    q.area = sum(sqrt(sum(n .^ 2, 2))) / 2;
    vol = zeros(ne, 1);
    q.volume = sum(dotrows(a, crossrows(b, c))) / 6;
  case 'quad'
    d1 = X(E(:, 3), :) - X(E(:, 1), :); d2 = X(E(:, 4), :) - X(E(:, 2), :);
    vol = sqrt(sum(crossrows(d1, d2) .^ 2, 2)) / 2;
    q.area = sum(vol);
    q.volume = q.area;
  case 'voxel'
    vol = info.h ^ 3 * ones(ne, 1);
    q.volume = sum(vol);
  case 'hex8'
    T = [1 2 3 7; 1 3 4 7; 1 4 8 7; 1 8 5 7; 1 5 6 7; 1 6 2 7];
    vol = zeros(ne, 1);
    for k = 1:6
      vol = vol + tetvol(X, E(:, T(k, :)));
    end
    q.volume = sum(vol);
  case 'tet4'
    vol = tetvol(X, E);
    q.volume = sum(vol);
  case 'tet10'
    vol = t10vol(X, E);
    q.volume = sum(vol);
  otherwise
    error('mesh_quality: unknown mesh kind %s', info.kind);
end
q.vol = vol;
q.minVol = min(vol);
q.maxVol = max(vol);
q.inverted = sum(vol <= 0);
if strcmp(info.kind, 'tri')
  q.inverted = 0;
end
if strcmp(info.kind, 'tet4') || strcmp(info.kind, 'tet10')
  t = meshQuality(m);
  q.minDihedral = t.minDihedral; q.maxDihedral = t.maxDihedral; q.maxAspect = t.maxAspect;
end
if nargout == 0
  fprintf('%s mesh: %d nodes, %d elements, volume %.6g, element volume %.3g…%.3g, %d inverted', ...
    q.kind, q.nodes, q.elements, q.volume, q.minVol, q.maxVol, q.inverted);
  if ~isnan(q.minDihedral)
    fprintf(', dihedral angles %.1f°…%.1f°', q.minDihedral, q.maxDihedral);
  end
  fprintf('\n');
end
end

function v = tetvol(X, T)
% signed volumes of the tetrahedra T (ne×4 node numbers)
a = X(T(:, 1), :);
v = dotrows(X(T(:, 2), :) - a, crossrows(X(T(:, 3), :) - a, X(T(:, 4), :) - a)) / 6;
end

function v = t10vol(X, E)
% isoparametric volume of 10-node tetrahedra, 4-point Gauss rule (weights 1/24)
ne = size(E, 1);
ga = 0.5854101966249685; gb = 0.1381966011250105;
P = [gb gb gb; ga gb gb; gb ga gb; gb gb ga];
dL = [-1 -1 -1; 1 0 0; 0 1 0; 0 0 1];          % rows L1…L4, columns d/dξ d/dη d/dζ
ed = [1 2; 2 3; 1 3; 1 4; 2 4; 3 4];            % mid-side nodes 5…10 sit on these corner pairs
Xc = cell(1, 3);
for i = 1:3
  Xc{i} = reshape(X(E(:), i), ne, 10);
end
v = zeros(ne, 1);
for p = 1:4
  L = [1 - sum(P(p, :)), P(p, :)];
  dN = zeros(10, 3);
  for k = 1:4
    dN(k, :) = (4 * L(k) - 1) * dL(k, :);
  end
  for k = 1:6
    i = ed(k, 1); j = ed(k, 2);
    dN(4 + k, :) = 4 * (L(i) * dL(j, :) + L(j) * dL(i, :));
  end
  J = cell(3, 3);
  for i = 1:3
    for j = 1:3
      J{i, j} = Xc{i} * dN(:, j);
    end
  end
  d = J{1,1} .* (J{2,2} .* J{3,3} - J{2,3} .* J{3,2}) - J{1,2} .* (J{2,1} .* J{3,3} - J{2,3} .* J{3,1}) + J{1,3} .* (J{2,1} .* J{3,2} - J{2,2} .* J{3,1});
  v = v + d / 24;
end
end

function c = crossrows(a, b)
c = [a(:, 2) .* b(:, 3) - a(:, 3) .* b(:, 2), a(:, 3) .* b(:, 1) - a(:, 1) .* b(:, 3), a(:, 1) .* b(:, 2) - a(:, 2) .* b(:, 1)];
end

function d = dotrows(a, b)
d = sum(a .* b, 2);
end
