% lbm3d — 3-D (or 2-D) flow with PartCraft's lattice Boltzmann kernel (D3Q19, TRT), driven from script
%
% Usage:      r = lbm3d(kind)
%             r = lbm3d(kind, opts)
%   kind      nx × ny × nz (or nx × ny) array of cell types: -1 wall, 0 fluid, g ≥ 1 a boundary cell of group g
%   opts      struct, all optional (lattice units): groups = { struct('type', 'velocity', 'u', [ux uy uz]),
%             struct('type', 'pressure', 'rho', 1), struct('type', 'wall'|'slip') … } (group g = groups{g});
%             tau 0.8 (ν = (τ − ½)/3), force [Fx Fy Fz] (body force), periodic [px py pz] (default: z periodic for
%             a 2-D kind), u0, maxSteps 20000, tol 1e-9 (relative velocity change over `every` steps), every 200,
%             show true
% Returns:    r.ux, r.uy, r.uz, r.rho (the shape of kind; NaN outside the fluid), r.steps, r.converged, r.res
%             (residual history, plotted), r.mesh (a hexGrid of the cells), r.fields {velocity (element, 3
%             components)}.
% Method:     the time loop and the convergence test are here; the hot kernel is flow.js (lbmInit builds the
%             lattice: fluid cells, links, boundary groups; lbmStep advances n steps: two-relaxation-time collision
%             with the "magic" Λ = 3/16, half-way bounce-back walls, velocity/pressure boundaries (the same code as
%             PartCraft's Flow workspace); lbmField reads u and ρ back).
% Units:      lattice units (see lbm2d for the mapping to physical ones; PartCraft's Flow workspace does it for
%             you). Keep |u| < 0.1.
% Assumes:    weakly compressible, isothermal, laminar (no turbulence model from script).
% Limits:     memory about 19 × 2 doubles per fluid cell; a few million cells is the practical limit in a page.
% References: I. Ginzburg, F. Verhaeghe, D. d'Humières, "Two-relaxation-time lattice Boltzmann scheme",
%             Commun. Comput. Phys. 3 (2008) 427–478 (TRT, Λ = 3/16 makes bounce-back walls exact for Poiseuille);
%             T. Krüger et al., The Lattice Boltzmann Method (2017) §10.7 (TRT), §4.1 (Poiseuille flow).
% Check:      a channel 4 × 22 cells, walls in rows 1 and 22 (H = 20), periodic in x and z, τ = 0.9, F = 1e-6:
%             profile vs F y (H − y)/2ν within 2 % of the peak (bin/test-craftscript.mjs --lib).
function r = lbm3d(kind, opts)
if nargin < 2
  opts = struct();
end
dom = struct('kind', kind, 'tau', getopt(opts, 'tau', 0.8));
for name = {'groups', 'force', 'periodic', 'u0'}
  if isfield(opts, name{1})
    dom.(name{1}) = opts.(name{1});
  end
end
maxSteps = getopt(opts, 'maxSteps', 20000);
tol = getopt(opts, 'tol', 1e-9);
every = getopt(opts, 'every', 200);

S = lbmInit(dom);
fl = lbmField(S);
uo = fl.ux; vo = fl.uy; wo = fl.uz;
fluid = ~isnan(uo);
res = zeros(1, 0);
converged = false;
steps = 0;
while steps < maxSteps
  S = lbmStep(S, every);
  steps = steps + every;
  fl = lbmField(S);
  du = abs(fl.ux - uo) + abs(fl.uy - vo) + abs(fl.uz - wo);
  umax = max(sqrt(fl.ux(fluid) .^ 2 + fl.uy(fluid) .^ 2 + fl.uz(fluid) .^ 2));
  d = max(du(fluid)) / max(umax, 1e-30);
  res(end + 1) = d;
  uo = fl.ux; vo = fl.uy; wo = fl.uz;
  if d < tol
    converged = true;
    break
  end
end
lbmFree(S);
plot(every * (1:numel(res)), res, 'title', 'lbm3d: velocity change', 'xlabel', 'step', 'ylabel', 'max |Δu| / max |u|', 'log', 'y', 'id', 'lbm3d');

r = struct('ux', fl.ux, 'uy', fl.uy, 'uz', fl.uz, 'rho', fl.rho, 'steps', steps, 'converged', converged, 'res', res);
sz = size(kind);
if numel(sz) < 3
  sz(3) = 1;
end
r.mesh = hexGrid(sz(1), sz(2), sz(3), sz(1), sz(2), sz(3));
U = [fl.ux(:), fl.uy(:), fl.uz(:)];
U(isnan(U)) = 0;
r.fields = {field(r.mesh, U, 'elem', 'velocity', 'cells/step')};
fprintf('lbm3d: %d × %d × %d cells (%d fluid), %d steps, max |u| %.4g\n', sz(1), sz(2), sz(3), sum(fluid(:)), steps, umax);
if getopt(opts, 'show', true)
  show(r.fields{1}, 'name', 'lbm3d: velocity');
end
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
