% Cantilever stress — a library example (run it with F5; "Make a copy" to change it)
%
% A steel bar 100 × 10 × 10 mm is held at x = 0 and carries 100 N downward at its free end. The script meshes it
% with cubes (box_mesh), solves it (static_voxel), compares the tip deflection with beam theory (δ = P L³ / 3EI)
% at four element sizes — plotted, so you can see the answer converge — and shows the von Mises stress on the
% deformed bar (finest mesh). The root stress from beam theory is M c / I = P L (b/2) / I = 60 MPa at the top and
% bottom faces; the element-centre stresses sit h/2 inside, so they read a little lower.
% Units: mm, N, MPa.
clf                                    % start with an empty canvas and dock
L = 100; b = 10; P = 100;            % length, square section side, load
E = 200000; nu = 0.3;                % steel
I = b^4 / 12;
beam = P * L^3 / (3 * E * I);        % Euler–Bernoulli tip deflection
sizes = [5 10/3 2.5 2];
tipd = zeros(size(sizes));
for k = 1:numel(sizes)
  h = sizes(k);
  v = box_mesh(L, b, b, h, 'voxel');
  bc = struct('fixed', nodes_at(v, 1, 0));
  tip = nodes_at(v, 1, L);
  bc.loads = {struct('nodes', tip, 'force', [0 0 -P])};
  r = static_voxel(v, E, nu, bc, struct('show', k == numel(sizes)));
  tipd(k) = -mean(r.U(tip, 3));
  fprintf('h = %5.3g mm: tip deflection %.5f mm (beam theory %.5f, %+.2f %%)\n', h, tipd(k), beam, 100 * (tipd(k) / beam - 1));
end
plot(sizes, 100 * (tipd / beam - 1), 'title', 'Cantilever: tip deflection vs beam theory', 'xlabel', 'element size h (mm)', 'ylabel', 'difference (%)');
fprintf('largest von Mises stress %.1f MPa (beam theory at the root surface %.1f MPa)\n', r.maxVm, P * L * (b / 2) / I);
