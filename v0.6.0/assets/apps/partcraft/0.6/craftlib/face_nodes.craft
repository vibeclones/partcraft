% face_nodes — the nodes (and boundary triangles) of one face of a tetrahedral mesh
%
% Usage:      [nodes, tris] = face_nodes(t, face)
%             fixed = face_nodes(box_mesh(100, 10, 10, 5, 'tet10'), 5);     the x = 0 end of the box
% Computes:   nodes — the 1-based numbers of every node on the boundary triangles the mesher tagged with face
%             `face` (1-based: the model's face order; box_mesh / cylinder_mesh list theirs), mid-side nodes
%             included for a 'tet10' mesh; tris — those triangles, one row each: 3 corner nodes (tet4), or 3
%             corners then the mid-sides of edges 1–2, 2–3, 3–1 (tet10, the 6-node triangle order).
% Method:     the tet mesh carries its boundary triangles (btri, 0-based corners) and their face (bface, 0-based);
%             the mid-side node of a boundary edge is found among the elements' edges by matching the edge key
%             min·n + max (ismember), with the T10 edge order (1 2)(2 3)(1 3)(1 4)(2 4)(3 4).
% Units:      none (node numbers).
% Limits:     tet4 and tet10 meshes only: voxel and hexahedron meshes carry no faces — pick their nodes by
%             position with nodes_at.
% References: PartCraft tetmesh.js (toT10: the same edge numbering).
% Check:      the box 100 × 10 × 10 'tet10': face 6 (x = 100) gives only nodes with x = 100, its triangles add
%             up to 10 × 10 = 100 (bin/test-craftscript.mjs --lib, through static_tet's face loads).
function [nodes, tris] = face_nodes(t, face)
info = meshInfo(t);
if ~strcmp(info.kind, 'tet4') && ~strcmp(info.kind, 'tet10')
  error('face_nodes: a tet4 or tet10 mesh is needed (got %s); for voxel and hex meshes use nodes_at', info.kind);
end
bt = t.btri;
bf = t.bface;
B = reshape(bt, 3, numel(bt) / 3)' + 1;          % boundary triangles, 1-based corners
pick = find(bf == face - 1);
if isempty(pick)
  error('face_nodes: no boundary triangle is on face %d (faces 1…%d)', face, max(bf) + 1);
end
tris = B(pick, :);
if strcmp(info.kind, 'tet10')
  E = meshElems(t);
  n = info.nodes;
  a = E(:, [1 2 1 1 2 3]); b = E(:, [2 3 3 4 4 4]); mid = E(:, 5:10);
  ekey = min(a(:), b(:)) * n + max(a(:), b(:));
  p = tris(:, [1 2 3]); r = tris(:, [2 3 1]);
  tkey = min(p(:), r(:)) * n + max(p(:), r(:));
  [found, loc] = ismember(tkey, ekey);
  if ~all(found)
    error('face_nodes: a boundary edge has no mid-side node (the mesh is not a T10 mesh of its own boundary)');
  end
  tris = [tris, reshape(mid(loc), size(tris, 1), 3)];
end
nodes = unique(tris(:));
end
