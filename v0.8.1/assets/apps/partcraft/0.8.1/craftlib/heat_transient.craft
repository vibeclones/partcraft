% heat_transient — transient heat conduction on a cube mesh, stepped in time
%
% Usage:      r = heat_transient(m, k, rc, bc, dt, nsteps, T0)
%             r = heat_transient(m, k, rc, bc, dt, nsteps, T0, opts)
%   m, k, bc  as heat_system (voxel or hex8 cubes; W/(mm·K); bc.T, bc.power, bc.q, bc.flux, bc.conv)
%   rc        volumetric heat capacity ρ·c (J/(mm³·K): aluminium 2.43e-3, steel 3.6e-3, water 4.18e-3)
%   dt        time step (s);  nsteps: number of steps;  T0: start temperature (a number, or one per node)
%   opts      struct, optional: theta (1 = backward Euler, the default; 0.5 = Crank–Nicolson), probe (node
%             numbers: their temperatures are recorded every step), show (true)
% Returns:    r.T (temperatures at the end), r.time (0, dt, … , nsteps·dt), r.mean (volume-weighted mean
%             temperature at each time), r.probe (one column per probe node), r.fields {temperature},
%             and a plot of the mean (and probe) temperature against time.
% Method:     C dT/dt + K T = f with C the lumped capacity (ρc·h³/8 to each corner of every cube) and K, f from
%             heat_system; the θ-method:  (C/Δt + θK) Tⁿ⁺¹ = (C/Δt − (1−θ)K) Tⁿ + f,  fixed temperatures held
%             at every step. Each step solves with K\f (fine up to some 10⁵ nodes; the matrix is the same at
%             every step).
% Units:      mm, W, J, K, s.
% Assumes:    constant properties; no radiation; f constant in time.
% Limits:     θ = 1 is unconditionally stable and damps (first order in Δt); θ = 0.5 is second order but can
%             ring when Δt is large compared with h²·ρc/k.
% References: R. W. Lewis et al., Fundamentals of the FEM for Heat and Fluid Flow (2004) §6.2–6.4 (lumped
%             capacity, θ-method); Incropera & DeWitt (6th ed.) §5.2, eq. 5.6 (lumped capacitance:
%             T − T∞ = (T0 − T∞) exp(−hA t / ρcV), valid for Bi = h L / k < 0.1) and §5.5 (plane wall, separation
%             of variables: a sin(πx/L) start decays as exp(−α π² t / L²), α = k / ρc).
% Check:      a 10 mm aluminium cube, hc = 1e-5 W/(mm²·K) on all faces (Bi = 5e-4), 100 → 20 °C: mean
%             temperature at t = τ = ρcV/(hA) vs exp(−1) (≤ 1 %); a 100 mm slab, ends at 0, start sin(πx/L): the
%             decay at t = L²/(απ²) vs exp(−1) (≤ 2 %) (bin/test-craftscript.mjs --lib).
function r = heat_transient(m, k, rc, bc, dt, nsteps, T0, opts)
if nargin < 8
  opts = struct();
end
s = heat_system(m, k, bc);
nn = numel(s.f);
th = getopt(opts, 'theta', 1);
c = rc * s.nodeVolume;                         % lumped heat capacity per node (J/K)
C = sparse(1:nn, 1:nn, c, nn, nn);
A = C / dt + th * s.K;
B = C / dt - (1 - th) * s.K;
T = T0 .* ones(nn, 1);
T(s.fixed) = s.Tfixed;
fr = s.free; fx = s.fixed;
Aff = A(fr, fr);
if ~isempty(fx)
  Afc = A(fr, fx);
end
probe = getopt(opts, 'probe', zeros(0, 1));
probe = probe(:);                              % a column, so T(probe)' is 1×0 when there is none (not [] — that deletes)
r = struct();
r.time = (0:nsteps)' * dt;
r.mean = zeros(nsteps + 1, 1);
r.probe = zeros(nsteps + 1, numel(probe));
V = sum(c(fr)) + sum(c(fx));
r.mean(1) = sum(c .* T) / V;
r.probe(1, :) = T(probe)';
for it = 1:nsteps
  rhs = B * T + s.f;
  rhs = rhs(fr);
  if ~isempty(fx)
    rhs = rhs - Afc * s.Tfixed;
  end
  T(fr) = Aff \ rhs;
  r.mean(it + 1) = sum(c .* T) / V;
  r.probe(it + 1, :) = T(probe)';
end
r.T = T;
r.fields = {field(m, T, 'node', 'temperature', 'K')};
fprintf('heat_transient: %d steps of %g s (theta %g), mean temperature %.5g → %.5g\n', nsteps, dt, th, r.mean(1), r.mean(end));
if getopt(opts, 'show', true)
  show(r.fields{1}, 'name', 'heat_transient: temperature');
  plot(r.time', r.mean', 'title', 'heat_transient: mean temperature', 'xlabel', 'time (s)', 'ylabel', 'T', 'name', 'mean', 'id', 'heat_transient');
  for j = 1:numel(probe)
    plot(r.time', r.probe(:, j)', 'id', 'heat_transient', 'append', true, 'name', sprintf('node %d', probe(j)));
  end
end
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
