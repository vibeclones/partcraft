% topopt3d — 3-D minimum-compliance topology optimization (SIMP) on a voxel mesh
%
% Usage:      r = topopt3d(v, E, nu, bc, volfrac)
%             r = topopt3d(v, E, nu, bc, volfrac, penal, rmin, opts)
%   v         a voxel mesh: the design space (box_mesh(…, 'voxel'), voxel_mesh(part(), h))
%   E, nu     the material (the optimal shape does not depend on E; the compliance does)
%   bc        as static_voxel: bc.fixed (nodes held in x, y, z), bc.supports, bc.loads = { struct('nodes', n,
%             'force', [Fx Fy Fz]) } (each total shared equally by its nodes)
%   volfrac   the material fraction to keep (0…1);  penal: SIMP power (3);  rmin: filter radius in mm (1.5 h)
%   opts      struct, optional: maxit (60), tol (0.01: stop when no density moves more), move (0.2), type ('h8',
%             as PartCraft's Generative workspace; 'h8i' stiffer in bending), show (true)
% Returns:    r.x (design variables), r.xPhys (filtered densities, one per element), r.c (compliance fᵀu of the
%             final xPhys, N·mm), r.loop (iterations), r.converged, r.hist (compliance per iteration), r.vol
%             (volume fraction per iteration), r.field (density, element) — shown on the canvas, with the
%             compliance plotted as it goes.
% Method:     as top88 with the density filter, in 3-D: E(x) = Emin + x^p (E − Emin) per cube (Emin = 1e-9 E);
%             each iteration solves K(x) u = f with voxelSolve (matrix-free, geometric multigrid PCG, warm start,
%             tol 1e-6 — the solver fea.js uses), element energies c_e = u_eᵀ Ke u_e (u(edofs) and hexKe),
%             c = Σ E_e c_e, ∂c/∂x̃ = −p x̃^(p−1) (1 − Emin) c_e; the density filter x̃ = H x / Hs with
%             H_ij = max(0, rmin − |c_i − c_j|) between cube centres (built here as a sparse matrix, one offset at a
%             time), sensitivities filtered with Hᵀ; optimality criteria with bisection on the multiplier until
%             (l2 − l1)/(l1 + l2) ≤ 1e-5 so the filtered volume meets volfrac exactly.
% Units:      mm, N, MPa → compliance in N·mm.
% Assumes:    one load case, linear elasticity, one material; every cube of v is design space (no keep-outs).
% Limits:     grey elements remain at member edges (no projection); no stress or manufacturing constraints.
% References: E. Andreassen et al., Struct. Multidisc. Optim. 43 (2011) 1–16 (§2.3 density filter, eqs. 9–11);
%             K. Liu, A. Tovar, "An efficient 3D topology optimization code written in Matlab", Struct.
%             Multidisc. Optim. 50 (2014) 1175–1196 (top3d); B. Bourdin, Int. J. Numer. Meth. Eng. 50 (2001) 2143–2158
%             (the density filter).
% Check:      a 20 × 10 × 2 mm cantilever plate of 1 mm cubes, x = 0 held, 1 N along −y on the lower end edge,
%             volfrac 0.4, rmin 1.5: converges (change ≤ 0.01, 46 iterations), the filtered volume stays 0.400, the
%             compliance falls; PartCraft's Generative optimiser (topopt.js optimize, the same settings, keepBC off)
%             ends within 1 % of the same compliance (bin/test-craftscript.mjs --lib).
function r = topopt3d(v, E, nu, bc, volfrac, penal, rmin, opts)
if nargin < 6
  penal = 3;
end
info = meshInfo(v);
if ~strcmp(info.kind, 'voxel')
  error('topopt3d: a voxel mesh is needed (got %s)', info.kind);
end
h = info.h; nn = info.nodes; ne = info.elements; n = 3 * nn;
if nargin < 7
  rmin = 1.5 * h;
end
if nargin < 8
  opts = struct();
end
maxit = getopt(opts, 'maxit', 60);
tolx = getopt(opts, 'tol', 0.01);
move = getopt(opts, 'move', 0.2);
type = getopt(opts, 'type', 'h8');
Emin = 1e-9;
D = edofs(v);
Ke = hexKe(E, nu, h, type);
[f, held] = loads_and_supports(bc, n);

% density filter: H(i, j) = max(0, rmin/h − distance) between element centres, in element units
id = v.elemIds;                                % 0-based grid element of each element
nx = info.nx; ny = info.ny; nz = info.nz;
gi = mod(id, nx); gj = mod(floor(id / nx), ny); gk = floor(id / (nx * ny));
lookup = zeros(nx * ny * nz, 1);
lookup(id + 1) = (1:ne)';
re = rmin / h;
R = ceil(re);
iH = []; jH = []; sH = [];
for dk = -R:R
  for dj = -R:R
    for di = -R:R
      w = re - sqrt(di^2 + dj^2 + dk^2);
      if w <= 0
        continue
      end
      a = gi + di; b = gj + dj; c = gk + dk;
      ok = a >= 0 & a < nx & b >= 0 & b < ny & c >= 0 & c < nz;
      e = find(ok);
      nb = lookup(a(ok) + nx * (b(ok) + ny * c(ok)) + 1);
      e = e(nb > 0); nb = nb(nb > 0);
      iH = [iH; e]; jH = [jH; nb]; sH = [sH; w * ones(numel(e), 1)];
    end
  end
end
H = sparse(iH, jH, sH, ne, ne);
Hs = sum(H, 2);
Ht = H';

x = volfrac * ones(ne, 1);
xPhys = x;
u = [];
hist = zeros(1, 0); vols = zeros(1, 0);
change = 1;
loop = 0;
while change > tolx && loop < maxit
  loop = loop + 1;
  s = Emin + xPhys .^ penal * (1 - Emin);
  so = struct('scale', s, 'tol', 1e-6, 'type', type);
  if ~isempty(u)
    so.x0 = u;
  end
  u = voxelSolve(v, E, nu, held, f, so);
  Ue = u(D);
  ce = sum((Ue * Ke) .* Ue, 2);                % u_eᵀ Ke u_e (Ke at the full E)
  c = sum(s .* ce);
  dc = -penal * (1 - Emin) * xPhys .^ (penal - 1) .* ce;
  dc = Ht * (dc ./ Hs);                         % chain rule through the density filter
  dv = Ht * (ones(ne, 1) ./ Hs);
  l1 = 0; l2 = 1e9;
  while (l2 - l1) / (l1 + l2) > 1e-5
    lmid = 0.5 * (l2 + l1);
    xnew = max(0, max(x - move, min(1, min(x + move, x .* sqrt(max(0, -dc) ./ dv / lmid)))));
    xPhys = (H * xnew) ./ Hs;
    if sum(xPhys) > volfrac * ne
      l1 = lmid;
    else
      l2 = lmid;
    end
  end
  change = max(abs(xnew - x));
  x = xnew;
  hist(loop) = c; vols(loop) = mean(xPhys);
  fprintf(' It.:%4i Obj.:%12.5g Vol.:%6.3f ch.:%6.3f\n', loop, c, vols(loop), change);
  plot(hist, 'title', 'topopt3d: compliance', 'xlabel', 'iteration', 'ylabel', 'c (N·mm)', 'id', 'topopt3d');
end
% the compliance of the densities returned
s = Emin + xPhys .^ penal * (1 - Emin);
u = voxelSolve(v, E, nu, held, f, struct('scale', s, 'tol', 1e-8, 'type', type, 'x0', u));
r = struct('x', x, 'xPhys', xPhys, 'c', f' * u, 'loop', loop, 'converged', change <= tolx, 'hist', hist, 'vol', vols);
r.field = field(v, xPhys, 'elem', 'density');
if getopt(opts, 'show', true)
  show(r.field, 'name', 'topopt3d: density', 'range', [0 1]);
end
end

function [f, held] = loads_and_supports(bc, n)
% the load vector (each total force shared equally by its nodes) and the held dofs, as static_voxel
f = zeros(n, 1);
loads = getopt(bc, 'loads', {});
for k = 1:numel(loads)
  nd = loads{k}.nodes(:); F = loads{k}.force(:)';
  for a = 1:3
    f = f + accumarray(3 * nd - 3 + a, F(a) / numel(nd), [n 1]);
  end
end
fx = getopt(bc, 'fixed', []);
fx = fx(:);
held = [3 * fx - 2; 3 * fx - 1; 3 * fx];
sup = getopt(bc, 'supports', {});
for k = 1:numel(sup)
  for a = sup{k}.dirs(:)'
    held = [held; 3 * sup{k}.nodes(:) - 3 + a];
  end
end
held = unique(held);
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
