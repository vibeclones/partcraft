% heat_steady — steady heat conduction on a cube mesh: temperatures, heat flux, heat through the fixed nodes
%
% Usage:      r = heat_steady(m, k, bc)
%             r = heat_steady(m, k, bc, opts)
%   m, k, bc  as heat_system: a voxel or hex8 mesh of cubes, conductivity W/(mm·K), and the conditions bc.T
%             (fixed temperatures), bc.power, bc.q (generation), bc.flux, bc.conv (convection)
%   opts      struct, optional: show (true)
% Returns:    r.T (nodes × 1, K or °C as given), r.flux (elements × 3, heat flux −k∇T at each cube centre,
%             W/mm²), r.heatOut (power flowing out through the fixed-temperature nodes, W), r.Tmin, r.Tmax,
%             r.fields {temperature (node), heat flux (element, 3 components)}.
% Method:     K T = f (heat_system), the fixed temperatures moved to the right-hand side:
%             K_ff T_f = f_f − K_fc T_c, solved with K\f (envelope Cholesky). Flux: the trilinear shape functions'
%             gradients at the cube centre, ∂N/∂x = (±1)/(4h) per corner. Heat out = Σ (K T − f) over fixed nodes.
% Units:      mm, W, K.
% Assumes:    steady state, linear (constant k), no radiation.
% Limits:     cube meshes only (see heat_system); a mesh with no fixed temperature needs convection somewhere, or
%             the problem has no unique solution.
% References: F. P. Incropera, D. P. DeWitt, Fundamentals of Heat and Mass Transfer (6th ed., 2007) §3.5,
%             eq. 3.40 (plane wall with generation: T(x) = T_s + q x (L − x) / 2k); R. W. Lewis et al.,
%             Fundamentals of the FEM for Heat and Fluid Flow (2004) ch. 3.
% Check:      a slab 100 mm long (20 cubes of 5 mm), k = 0.05, q = 1e-3 W/mm³, both ends at 20: T(x) =
%             20 + q x (L − x) / 2k at every node (25 K rise at mid-length; ≤ 0.1 %), and the heat out = q·V
%             (bin/test-craftscript.mjs --lib).
function r = heat_steady(m, k, bc, opts)
if nargin < 4
  opts = struct();
end
s = heat_system(m, k, bc);
nn = numel(s.f);
T = zeros(nn, 1);
T(s.fixed) = s.Tfixed;
if isempty(s.fixed) && ~isfield(bc, 'conv')
  error('heat_steady: give a fixed temperature (bc.T) or convection (bc.conv): otherwise the temperature level is not set');
end
rhs = s.f(s.free);
if ~isempty(s.fixed)
  rhs = rhs - s.K(s.free, s.fixed) * s.Tfixed;
end
T(s.free) = s.K(s.free, s.free) \ rhs;

% heat flux at the cube centres
E8 = meshElems(m);
Te = T(E8);
h = s.h;
gx = [-1 1 1 -1 -1 1 1 -1] / (4 * h);
gy = [-1 -1 1 1 -1 -1 1 1] / (4 * h);
gz = [-1 -1 -1 -1 1 1 1 1] / (4 * h);
flux = -k * [Te * gx', Te * gy', Te * gz'];

R = s.K * T - s.f;
r = struct();
r.T = T; r.flux = flux;
r.heatOut = -sum(R(s.fixed));                 % K T − f at a fixed node = heat the boundary puts in
r.Tmin = min(T(E8(:))); r.Tmax = max(T(E8(:)));
r.fields = {field(m, T, 'node', 'temperature', 'K'), field(m, flux, 'elem', 'heat flux', 'W/mm²')};
fprintf('heat_steady: %d cubes of %g, temperature %.4g…%.4g, heat out through the fixed nodes %.4g W\n', ...
  size(E8, 1), h, r.Tmin, r.Tmax, r.heatOut);
if getopt(opts, 'show', true)
  show(r.fields{1}, 'name', 'heat_steady: temperature');
end
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
