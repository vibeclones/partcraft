% static_voxel — linear static stress analysis on a voxel mesh (cubes): displacements, stresses, reactions
%
% Usage:      r = static_voxel(v, E, nu, bc)
%             r = static_voxel(v, E, nu, bc, opts)
%   v         a voxel mesh (voxel_mesh, box_mesh(…, 'voxel'), voxelize)
%   E, nu     Young's modulus and Poisson's ratio (one material)
%   bc        struct: bc.fixed = node numbers held in x, y and z (nodes_at picks them by position);
%             optional bc.supports = { struct('nodes', n, 'dirs', [1 3]), … } (held only in those directions);
%             bc.loads = { struct('nodes', n, 'force', [Fx Fy Fz]), … } — each total force shared equally by its nodes
%   opts      struct, all optional: solver 'direct' (assemble + K\f, the default up to 60 000 unknowns) or
%             'multigrid' (matrix-free voxelSolve, PartCraft's own solver; the default above that); tol 1e-8
%             (multigrid); type 'h8i' (default, incompatible modes) or 'h8'; show true (draw the result)
% Returns:    r.u (3·nodes × 1, node-major: u = [u1x u1y u1z u2x …]), r.U (nodes × 3), r.stress (elements × 6:
%             σxx σyy σzz τxy τyz τzx at the cube centres), r.vm (von Mises per element), r.compliance (fᵀu),
%             r.reaction (total support force [x y z]), r.maxDisp, r.maxVm, r.dofs, r.solver, r.fields
%             {displacement (node, 3), von Mises (element)} — shown on the canvas, deformed.
% Method:     K = Σ_e Ke over the elements: every cube has the same 24×24 matrix (hexKe: the h8i element with
%             incompatible bending modes, Wilson–Taylor, as fea.js), so assemble() adds it at each element's 24 dofs
%             (edofs). Supports remove their dofs; u_free = K_ff \ f_f (envelope Cholesky; PCG when too big).
%             Stresses σ = S·u_e at each cube's centre (rows 49–54 of hexStressOp, the same operator fea.js uses).
%             Reactions = K u − f at the held dofs, from the element forces (no K needed: Σ_e Ke·u_e).
% Units:      consistent: mm, N, MPa (PartCraft) → displacements in mm, stresses in MPa.
% Assumes:    small strains and displacements, linear isotropic elasticity, the loads are point forces at nodes.
% Limits:     cubes only (the staircase follows curved faces in steps of h); stresses at re-entrant corners and
%             under point loads grow as h shrinks (singular), read them a few elements away.
% References: E. L. Wilson, R. L. Taylor et al., "Incompatible displacement models", in Numerical and Computer
%             Methods in Structural Mechanics (1973) 43–57 (the h8i element); T. J. R. Hughes, The Finite Element
%             Method (1987) §4.7; Euler–Bernoulli tip deflection δ = P L³ / (3 E I) (S. Timoshenko, Strength of
%             Materials I, §36).
% Check:      cantilever 100 × 10 × 10 mm, E = 200 GPa, ν = 0.3, x = 0 held, P = 100 N down at x = 100, h = 2.5:
%             tip deflection vs P L³/3EI = 0.2000 mm (≤ 3 %), and the same model in PartCraft's Simulation solver
%             (fea.js solveStudy) to ≤ 1 % (bin/test-craftscript.mjs --lib).
function r = static_voxel(v, E, nu, bc, opts)
if nargin < 5
  opts = struct();
end
t0 = tic;
info = meshInfo(v);
if ~strcmp(info.kind, 'voxel')
  error('static_voxel: a voxel mesh is needed (got %s); for tetrahedra use static_tet', info.kind);
end
h = info.h; nn = info.nodes; n = 3 * nn;
type = getopt(opts, 'type', 'h8i');
D = edofs(v);                                  % elements × 24 dof numbers (node-major)
Ke = hexKe(E, nu, h, type);                    % 24×24, the same for every cube

% loads: each total force shared equally by its nodes
f = zeros(n, 1);
loads = getopt(bc, 'loads', {});
for k = 1:numel(loads)
  L = loads{k};
  nd = L.nodes(:);
  F = L.force(:)';
  for a = 1:3
    f = f + accumarray(3 * nd - 3 + a, F(a) / numel(nd), [n 1]);
  end
end

% supports → held dofs
held = [];
fixedNodes = getopt(bc, 'fixed', []);
fixedNodes = fixedNodes(:);
held = [held; 3 * fixedNodes - 2; 3 * fixedNodes - 1; 3 * fixedNodes];
sup = getopt(bc, 'supports', {});
for k = 1:numel(sup)
  for a = sup{k}.dirs(:)'
    held = [held; 3 * sup{k}.nodes(:) - 3 + a];
  end
end
held = unique(held);
if isempty(held)
  error('static_voxel: nothing holds the part (give bc.fixed or bc.supports)');
end

% the unknowns: dofs of nodes some cube uses, less the held ones
E8 = meshElems(v);
used = false(nn, 1); used(E8(:)) = true;
act = find(used);
actDofs = [3 * act - 2, 3 * act - 1, 3 * act]';
free = setdiff(actDofs(:), held);
dofs = numel(free);

solver = getopt(opts, 'solver', '');
if isempty(solver)
  if dofs <= 60000
    solver = 'direct';
  else
    solver = 'multigrid';
  end
end
u = zeros(n, 1);
switch solver
  case 'direct'
    K = assemble(D, Ke, [], n);
    u(free) = K(free, free) \ f(free);
  case 'multigrid'
    [u, sinfo] = voxelSolve(v, E, nu, held, f, struct('tol', getopt(opts, 'tol', 1e-8), 'type', type));
    fprintf('static_voxel: multigrid PCG, %d iterations, residual %.1e\n', sinfo.iterations, sinfo.residual);
  otherwise
    error('static_voxel: solver must be direct or multigrid');
end

% post-processing: stresses at the cube centres, reactions from the element forces
Ue = u(D);                                     % elements × 24
S = hexStressOp(E, nu, h, type);
s = Ue * S(49:54, :)';                         % elements × 6
vm = vonMises(s);
fint = accumarray(D(:), reshape(Ue * Ke, [], 1), [n 1]);   % K u, element by element
R = fint - f;
reaction = zeros(1, 3);
for a = 1:3
  ha = held(mod(held - 1, 3) == a - 1);
  reaction(a) = sum(R(ha));
end
U = reshape(u, 3, nn)';
dmag = sqrt(sum(U .^ 2, 2));

r = struct();
r.u = u; r.U = U; r.stress = s; r.vm = vm;
r.compliance = f' * u;
r.reaction = reaction;
r.maxDisp = max(dmag); r.maxVm = max(vm);
r.dofs = dofs; r.solver = solver; r.h = h;
r.fields = {field(v, U, 'node', 'displacement', 'mm'), field(v, vm, 'elem', 'von Mises stress', 'MPa')};
r.seconds = toc(t0);
fprintf('static_voxel: %d cubes of %g, %d unknowns (%s), max displacement %.4g, max von Mises %.4g, reaction [%.4g %.4g %.4g]\n', ...
  info.elements, h, dofs, solver, r.maxDisp, r.maxVm, reaction(1), reaction(2), reaction(3));
if getopt(opts, 'show', true)
  show(r.fields{2}, 'name', 'static_voxel: von Mises', 'deform', r.fields{1});
end
end

function v = getopt(s, name, default)
% a field of a struct, or the default when it is not there
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
