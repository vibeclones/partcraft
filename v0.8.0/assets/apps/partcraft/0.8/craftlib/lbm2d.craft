% lbm2d — 2-D incompressible flow by the lattice Boltzmann method (D2Q9, BGK), written out in script
%
% Usage:      r = lbm2d(solid)
%             r = lbm2d(solid, opts)
%   solid     nx × ny logical: true = wall cell (bounce-back), false = fluid. Edges wrap around (periodic):
%             put wall cells along an edge to close it.
%   opts      struct, all optional (lattice units: cell size 1, time step 1):
%             tau 0.9 (relaxation time: viscosity ν = (τ − ½)/3), force [Fx Fy] (body force per unit volume, e.g.
%             a pressure gradient), u0 [ux uy] (start velocity), maxSteps 20000, tol 1e-9 (stop when the largest
%             velocity change over `every` steps, relative to the largest velocity, is below it), every 100,
%             show true
% Returns:    r.ux, r.uy, r.rho (nx × ny; NaN in wall cells), r.steps, r.converged, r.res (residual history),
%             r.nu (lattice viscosity), r.mesh (quadGrid of the cells), r.fields {velocity (element, 3
%             components)} — shown, with the residual plotted (log scale) as the run goes.
% Method:     D2Q9 velocities c_k, weights 4/9, 1/9, 1/36; per step: moments ρ = Σf, ρu = Σ f c + F/2; BGK
%             collision toward f_eq = w ρ (1 + 3 c·u + 4.5 (c·u)² − 1.5 u²) with Guo's forcing term
%             S = (1 − 1/2τ) w [3 (c − u) + 9 (c·u) c]·F; streaming by one gather f ← f_post(IDX) where IDX
%             (built once) points each fluid cell's population k at its upstream neighbour, or — when that
%             neighbour is a wall — at its own post-collision population in the opposite direction (half-way
%             bounce-back: the wall sits half a cell from the last fluid cell, no-slip to second order).
%             Only fluid cells are stored (an N × 9 array).
% Units:      lattice units. To map to a fluid of viscosity ν (m²/s) on cells of dx (m): dt = (τ − ½)/3 · dx²/ν,
%             u_phys = u · dx/dt, F_phys = F · dx/dt². Keep |u| < 0.1 (low Mach number).
% Assumes:    weakly compressible (Ma ≪ 1), isothermal, Newtonian; steady state found by time stepping.
% Limits:     walls on the cell grid (staircase), no inlets/outlets (drive the flow with a body force on a
%             periodic domain), BGK only (τ near 1 is most accurate with bounce-back), no turbulence model —
%             lbm3d (PartCraft's D3Q19 TRT kernel) for 3-D.
% References: S. Succi, The Lattice Boltzmann Equation (2001); T. Krüger et al., The Lattice Boltzmann Method:
%             Principles and Practice (Springer 2017) — §3.4 (D2Q9, eq. 3.54), §6.3 (Guo forcing, eqs. 6.14 and
%             6.25), §5.3.3 (half-way bounce-back), §4.1 (Poiseuille: u(y) = F y (H − y) / 2ρν).
% Check:      a periodic channel 3 × 22 cells with walls in rows 1 and 22 (H = 20), τ = 0.9, F = 1e-6: the
%             velocity profile vs the analytic parabola within 2 % of its peak (bin/test-craftscript.mjs --lib).
function r = lbm2d(solid, opts)
if nargin < 2
  opts = struct();
end
[nx, ny] = size(solid);
tau = getopt(opts, 'tau', 0.9);
F = getopt(opts, 'force', [0 0]);
u0 = getopt(opts, 'u0', [0 0]);
maxSteps = getopt(opts, 'maxSteps', 20000);
tol = getopt(opts, 'tol', 1e-9);
every = getopt(opts, 'every', 100);
Fx = F(1); Fy = F(2);

% the lattice
cx = [0 1 0 -1 0 1 -1 -1 1];
cy = [0 0 1 0 -1 1 1 -1 -1];
w = [4/9 1/9 1/9 1/9 1/9 1/36 1/36 1/36 1/36];
opp = [1 4 5 2 3 8 9 6 7];

% fluid cells and the streaming index (built once)
fl = find(~solid(:));                          % fluid cells (column-major: cell = i + nx (j − 1))
N = numel(fl);
idx = zeros(nx * ny, 1);
idx(fl) = (1:N)';
[I, J] = ind2sub([nx ny], fl);
IDX = zeros(N, 9);
for k = 1:9
  ui = mod(I - 1 - cx(k), nx) + 1;             % the upstream cell (periodic wrap)
  uj = mod(J - 1 - cy(k), ny) + 1;
  up = idx(ui + nx * (uj - 1));
  wall = up == 0;
  src = up + N * (k - 1);
  src(wall) = find(wall) + N * (opp(k) - 1);   % bounce back: own population, opposite direction
  IDX(:, k) = src;
end

% start at rest (or u0), density 1
ux = u0(1) * ones(N, 1); uy = u0(2) * ones(N, 1); rho = ones(N, 1);
f = equilibrium(rho, ux, uy, cx, cy, w);
omega = 1 / tau;
cF = cx * Fx + cy * Fy;                         % c_k · F
gs = (1 - omega / 2) * w;
res = zeros(1, 0);
uold = zeros(N, 1); vold = zeros(N, 1);
converged = false;
step = 0;
while step < maxSteps
  step = step + 1;
  rho = sum(f, 2);
  ux = (f * cx' + Fx / 2) ./ rho;
  uy = (f * cy' + Fy / 2) ./ rho;
  feq = equilibrium(rho, ux, uy, cx, cy, w);
  cu = ux * cx + uy * cy;
  S = gs .* (3 * (cF - (ux * Fx + uy * Fy)) + 9 * cu .* cF);
  f = f - omega * (f - feq) + S;
  f = f(IDX);
  if mod(step, every) == 0
    umax = max(sqrt(ux .^ 2 + uy .^ 2));
    d = max(abs(ux - uold) + abs(uy - vold)) / max(umax, 1e-30);
    res(end + 1) = d;
    uold = ux; vold = uy;
    if d < tol
      converged = true;
      break
    end
  end
end
plot(every * (1:numel(res)), res, 'title', 'lbm2d: velocity change', 'xlabel', 'step', 'ylabel', 'max |Δu| / max |u|', 'log', 'y', 'id', 'lbm2d');

r = struct();
r.ux = NaN(nx, ny); r.uy = NaN(nx, ny); r.rho = NaN(nx, ny);
r.ux(fl) = ux; r.uy(fl) = uy; r.rho(fl) = rho;
r.steps = step; r.converged = converged; r.res = res;
r.nu = (tau - 0.5) / 3;
r.mesh = quadGrid(nx, ny, nx, ny);
U = [r.ux(:), r.uy(:), zeros(nx * ny, 1)];
U(isnan(U)) = 0;
r.fields = {field(r.mesh, U, 'elem', 'velocity', 'cells/step')};
fprintf('lbm2d: %d × %d cells (%d fluid), %d steps, %s, max |u| %.4g, ν = %.4g\n', nx, ny, N, step, ...
  ternary(converged, 'converged', 'not converged'), max(sqrt(ux .^ 2 + uy .^ 2)), r.nu);
if getopt(opts, 'show', true)
  show(r.fields{1}, 'name', 'lbm2d: velocity');
end
end

function feq = equilibrium(rho, ux, uy, cx, cy, w)
cu = ux * cx + uy * cy;                        % N × 9
feq = (rho * w) .* (1 + 3 * cu + 4.5 * cu .^ 2 - 1.5 * (ux .^ 2 + uy .^ 2));
end

function v = ternary(c, a, b)
if c
  v = a;
else
  v = b;
end
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
