% box_mesh — a mesh of the box [0, lx] × [0, ly] × [0, lz]
%
% Usage:      m = box_mesh(lx, ly, lz, h)            8-node hexahedra (the default kind 'hex')
%             m = box_mesh(lx, ly, lz, h, kind)      kind: 'hex' | 'voxel' | 'tet4' | 'tet10' | 'surface'
% Computes:   'hex'     structured hexahedron grid, round(l/h) elements per side (at least 1) — hexGrid
%             'voxel'   cubes of side h whose centres are inside the box (voxelize of the box surface)
%             'tet4'    body-fitted linear tetrahedra of size about h (tetmesh, isosurface stuffing)
%             'tet10'   the same mesh with mid-side nodes (quadratic tetrahedra)
%             'surface' the closed triangle surface (12 triangles; face k = 1…6 is x0 x1 y0 y1 z0 z1 … see below)
% Method:     a thin script over the mesh builtins (hexGrid, meshBox, voxelize, tetmesh). The tet meshes use the
%             same mesher settings as PartCraft's Simulation workspace (curv 0.25, thick 1, levels 3), so a script
%             and the workspace mesh the same box the same way.
% Units:      whatever length unit you use (PartCraft's studies use mm).
% Faces:      boundary faces of the surface and of tet meshes are numbered (1-based, as face_nodes takes them):
%             1 z = 0, 2 z = lz, 3 y = 0, 4 y = ly, 5 x = 0, 6 x = lx.
% Limits:     'hex' elements are cubes only when lx/nx = ly/ny = lz/nz (choose h so that l/h are whole numbers);
%             the heat and static drivers that use hexKt/hexKe need cubes.
% References: Labelle & Shewchuk, "Isosurface stuffing", ACM TOG 26(3) 2007 (the tet mesher).
% Check:      100 × 10 × 10 at h = 2.5: 'hex' 40·4·4 = 640 elements, volume 10000 (mesh_quality); 'voxel' 640
%             cubes; 'tet10' volume 10000 to 1e-9 (bin/test-craftscript.mjs --lib).
function m = box_mesh(lx, ly, lz, h, kind)
if nargin < 5
  kind = 'hex';
end
if ~(h > 0)
  error('box_mesh: the element size h must be positive');
end
switch kind
  case 'hex'
    n = max(1, round([lx ly lz] / h));
    m = hexGrid(lx, ly, lz, n(1), n(2), n(3));
  case 'voxel'
    m = voxelize(meshBox(lx, ly, lz), h);
  case 'tet4'
    m = tetmesh(meshBox(lx, ly, lz), h, struct('order', 1, 'curv', 0.25, 'thick', 1, 'levels', 3));
  case 'tet10'
    m = tetmesh(meshBox(lx, ly, lz), h, struct('order', 2, 'curv', 0.25, 'thick', 1, 'levels', 3));
  case 'surface'
    m = meshBox(lx, ly, lz);
  otherwise
    error('box_mesh: kind must be hex, voxel, tet4, tet10 or surface (got %s)', kind);
end
end
